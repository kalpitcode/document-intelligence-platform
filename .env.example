# ==============================================================================
# Enterprise AI Document Intelligence Platform
# Environment Configuration Template
#
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ==============================================================================

# --- Application ---
APP_NAME=document-intelligence-platform
APP_VERSION=0.1.0
APP_DESCRIPTION=Enterprise AI Document Intelligence Platform
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=DEBUG
APP_WORKERS=1

# --- API ---
API_V1_PREFIX=/api/v1

# --- Database (PostgreSQL) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=dip_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=document_intelligence
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10
POSTGRES_POOL_RECYCLE=3600
POSTGRES_ECHO=false

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=20

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=dip_user
RABBITMQ_PASSWORD=change_me_in_production
RABBITMQ_VHOST=/

# --- Celery ---
CELERY_BROKER_URL=amqp://dip_user:change_me_in_production@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# --- Logging ---
LOG_LEVEL=DEBUG
LOG_FORMAT=json
LOG_FILE=logs/app.log

# --- Security (future) ---
# SECRET_KEY=
# JWT_ALGORITHM=HS256
# JWT_EXPIRATION_MINUTES=30

# --- Trusted Hosts ---
TRUSTED_HOSTS=["localhost","127.0.0.1"]
